  "auditRules": {
    "_comment": "Maps Entra directoryAudits entries made by a Global Administrator to the least role that could have made them. First matching rule wins; selfService rules skip the account's own registration/SSPR events. Matched against activityDisplayName (activity), loggedByService (service) and category, as case-insensitive regex. Entra audit only: Exchange, Intune, SharePoint and Teams admin work is not in this log.",
    "rules": [
      { "service": "Self-service Password Management", "selfService": true },
      { "activity": "^user (registered|deleted|changed|reviewed|started)", "selfService": true },
      { "activity": "consent to application", "role": "Cloud Application Administrator" },
      { "service": "^PIM$", "role": "Privileged Role Administrator" },
      { "category": "^RoleManagement$", "role": "Privileged Role Administrator" },
      { "service": "Conditional Access", "role": "Conditional Access Administrator" },
      { "activity": "conditional access", "role": "Conditional Access Administrator" },
      { "activity": "authentication methods? policy|authentication method configuration", "role": "Authentication Policy Administrator" },
      { "activity": "security info|authentication method|strongauthentication|temporary access pass", "role": "Authentication Administrator" },
      { "activity": "reset (user )?password|change user password|set force change user password", "role": "Helpdesk Administrator" },
      { "activity": "license", "role": "License Administrator" },
      { "activity": "invite external user|redeem external user invite", "role": "Guest Inviter" },
      { "activity": "domain", "role": "Domain Name Administrator" },
      { "service": "Lifecycle Workflows", "role": "Lifecycle Workflows Administrator" },
      { "service": "Entitlement Management|Access Reviews", "role": "Identity Governance Administrator" },
      { "category": "^GroupManagement$", "role": "Groups Administrator" },
      { "category": "^UserManagement$", "role": "User Administrator" },
      { "category": "^ApplicationManagement$", "role": "Application Administrator" },
      { "category": "^(DeviceManagement|Device)$", "role": "Cloud Device Administrator" },
      { "service": "Device Registration Service", "role": "Cloud Device Administrator" },
      { "category": "^AdministrativeUnit$", "role": "Privileged Role Administrator" },
      { "activity": "set company information|update company|set dirsync|set partnership|tenant", "role": "Global Administrator" }
    ]
  }
}
