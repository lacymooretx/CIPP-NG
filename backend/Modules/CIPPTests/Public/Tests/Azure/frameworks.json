{
  "note": "Indicative mapping maintained by Aspendora for the AZ_ Azure subscription tests. Each test is tagged with control themes; each theme maps to the framework controls it supports. It shows which controls a technical check provides evidence for. It is not an auditor's control mapping and does not establish compliance with any framework.",
  "frameworks": {
    "MCSB": "Microsoft cloud security benchmark v1",
    "CISv8": "CIS Critical Security Controls v8 (safeguards)",
    "NISTCSF": "NIST Cybersecurity Framework 2.0 (categories)",
    "NIST80053": "NIST SP 800-53 Rev. 5",
    "CMMC": "CMMC 2.0 / NIST SP 800-171 Rev. 2",
    "SOC2": "SOC 2 Trust Services Criteria (2017)",
    "ISO27001": "ISO/IEC 27001:2022 Annex A"
  },
  "themes": {
